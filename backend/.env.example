PORT=4000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=Your-Database_Key
DB_NAME=airbnb_db
SESSION_SECRET=my-secret-key
NODE_ENV=development

PORT=4000
NODE_ENV=development
SESSION_SECRET=change_me_please

# MongoDB (app data + sessions)
MONGO_URL=mongodb://admin:mongopassword@localhost:27017/airbnb_sessions?authSource=admin

# Auth
JWT_SECRET=change_me_please

# Kafka (set KAFKA_ENABLED=false to run without a broker)
KAFKA_BROKER=localhost:9092
KAFKA_ENABLED=true

# Comma-separated browser origins allowed for REST + WebSocket
CORS_ORIGINS=http://localhost:3000
